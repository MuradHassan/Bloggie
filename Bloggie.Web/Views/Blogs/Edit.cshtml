@model Bloggie.Web.Models.ViewModels.EditBlogViewModel

@{
    ViewData["Title"] = "Blogs-Edit";
}

<div class="bg-secondary bg-opacity-10 py-2">
    <div class="container">
        <h1>
            Edit Blog - Admin Functionality
        </h1>
    </div>
</div>


<div class="container py-5">
    @if (Model != null)
    {
        <form method="post">

            <div class="mb-3">
                <lable class="form-lable">Id</lable>
                <input type="text" class="form-control" id="id" asp-for="Id" readonly />
            </div>
            <div class="mb-3">
                <lable class="form-lable">Heading</lable>
                <input type="text" class="form-control" id="heading" asp-for="Heading" />
            </div>
            <div class="mb-3">
                <lable class="form-lable">Page Title</lable>
                <input type="text" class="form-control" id="pageTitle" asp-for="PageTitle" />
            </div>
            <div class="mb-3">
                <lable class="form-lable">Content</lable>
                <textarea class="form-control" id="content" asp-for="Content"></textarea>
            </div>
            <div class="mb-3">
                <lable class="form-lable">Short Description</lable>
                <input type="text" class="form-control" id="shortDescription" asp-for="ShortDescription" />
            </div>

            <div class="mb-3">
                <label class="form-label">Featured Image Upload</label>
                <input type="file" id="featuredImageUpload" class="form-control" />
                @if (Model.FeaturedImageUrl != null)
                {
                    <img src="@Model.FeaturedImageUrl" id="featuredImageDisplay" style="display: block; width: 300px;" class="mt-3" />
                }
                else
                {
                    <img src="" id="featuredImageDisplay" style="display: none; width: 300px;" class="mt-3" />
                }
            </div>
            <div class="mb-3">
                <lable class="form-lable">Featured Image URL</lable>
                <input type="text" class="form-control" id="featuredImageUrl" asp-for="FeaturedImageUrl" />
            </div>
            <div class="mb-3">
                <lable class="form-lable">URL Handle</lable>
                <input type="text" class="form-control" id="UrlHandle" asp-for="UrlHandle" />
            </div>
            <div class="mb-3">
                <lable class="form-lable">Published Date</lable>
                <input type="date" class="form-control" id="publishedDate" asp-for="PublishedDate" />
            </div>
            <div class="mb-3">
                <lable class="form-lable">Author</lable>
                <input type="text" class="form-control" id="author" asp-for="Author" />
            </div>
            <div class="form-check mb-3">
                <input type="checkbox" class="form-check-input" id="visible" asp-for="Visible" />
                <label class="form-check-label">Is Visible?</label>
            </div>

            <div class="mb-3">
                <label class="form-label">Tags</label>
                <select class="form-select" asp-items="@Model.Tags" asp-for="SelectedTags">
                </select>
            </div>

            <div class="mb-3 d-flex">
                <a class="btn btn-secondary me-2 shadow-none" asp-controller="Blogs" asp-action="List">Back</a>
                <button type="submit" class="btn btn-success shadow-none">Update</button>
            </div>

        </form>
    }
    else
    {
        <p>No blog post found!</p>
    }
</div>

@section Scripts {
    <script>

        var editor = new FroalaEditor('#content',{
            imageUploadURL: 'api/images'
        });

        const featuredUploadElement = document.getElementById('featuredImageUpload');
        const featuredImageUrlElement = document.getElementById('featuredImageUrl');
        const featuredImageDisplayElement = document.getElementById('featuredImageDisplay');

        async function uploadFeaturedImage(e)
        {
            console.log(e.target.files[0]);
            let data = new FormData();
            data.append('file', e.target.files[0]);
            await fetch('/api/images', {
                method: 'POST',
                headers:{
                    'Aceept': '*/*'
                },
                body: data
            }).then(Response => Response.json())
            .then(resule => {
                featuredImageUrlElement.value = resule.link;
                featuredImageDisplayElement.src = resule.link;
                featuredImageDisplayElement.style.display = 'block';
            });
        }
        featuredUploadElement.addEventListener('change', uploadFeaturedImage);
    </script>
}