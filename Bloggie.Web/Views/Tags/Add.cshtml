@model Bloggie.Web.Models.ViewModels.AddTagViewModel

@{
    ViewData["Title"] = "Tags-Add";
}


<div class="bg-secondary bg-opacity-10 py-2">
    <div class="container">
        <h1>
            Add Tag - Admin Functionality
        </h1>
    </div>
</div>


<div class="container m-auto py-5 row justify-content-center">
    <div class="col-lg-4 mt-4 p-4 border border-2 rounded-3">
        <form method="post">
            <div class="mb-3">
                <lable class="form-label">Name</lable>
                <input type="text" class="form-control shadow-none" id="name" asp-for="Name" required />
                <span class="text-danger" asp-validation-for="Name"></span>
            </div>
            <div class="mb-3">
                <lable class="form-label">Display Name</lable>
                <input type="text" class="form-control shadow-none" id="DisplayName" asp-for="DisplayName" required />
                <span class="text-danger" asp-validation-for="DisplayName"></span>
            </div>
            <div>
                <a class="btn btn-secondary mt-2 shadow-none" asp-controller="Tags" asp-action="List">Back</a>
                <button type="submit" class="btn btn-success shadow-none mt-2">Add</button>
            </div>
        </form>
    </div>
</div>